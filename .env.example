GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.1-flash-lite   # optional — overrides the default model chain
GOOGLE_TTS_KEY=your_google_tts_key
PEXELS_API_KEY=your_pexels_key

# Public base URL used for shareable video/download/status links.
# If set, returned URLs are always absolute & public (recommended for cross-internet publishing).
PUBLIC_BASE_URL=https://shorts.teachieve.com

# Auto-delete generated videos after this many hours (default 24).
VIDEO_TTL_HOURS=24

# ─── TTS engines (ttsType: edge | google | kokoro | piper) ───────────────
# edge = افتراضي (بدون مفتاح). kokoro/piper = صوت عربي محلي/مجتمعي.

# Kokoro = Nabra-82M-v0.1 (نموذج عربي حقيقي، صوت af_msa أنثوي، 24kHz)
# يُحمَّل تلقائياً من HuggingFace عند أول استخدام (حوالي 327MB).
# KOKORO_LANG_CODE=ar
# KOKORO_VOICE=af_msa
# NABRA_REPO_ID=oddadmix/Nabra-82M-v0.1   # اختياري — المستودع الافتراضي
# NABRA_MODEL_DIR=./backend/models/nabra  # اختياري — مجلد تخزين الأوزان

# Piper (عربي حقيقي — ar_JO-kareem-medium يُنزَّل تلقائياً عند أول استخدام)
# PIPER_VOICE=ar_JO-kareem-medium
# PIPER_BIN=/usr/local/bin/piper   # اختياري — إن لم يكن في PATH


