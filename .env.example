GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.1-flash-lite   # optional — overrides the default model chain
GOOGLE_TTS_KEY=your_google_tts_key
PEXELS_API_KEY=your_pexels_key

# Public base URL used for shareable video/download/status links.
# If set, returned URLs are always absolute & public (recommended for cross-internet publishing).
PUBLIC_BASE_URL=https://shorts.teachhorizon.online

# Auto-delete generated videos after this many hours (default 24).
VIDEO_TTL_HOURS=24

